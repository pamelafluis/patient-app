# Copy to .env (gitignored) and edit. Never commit real values.

# FHIR R4 base URL. HTTPS required (http only for localhost).
FHIR_BASE_URL=https://r4.smarthealthit.org

# Optional bearer token. Leave blank for open servers. Put it here yourself;
# never paste it into chat, issues or commits.
FHIR_BEARER_TOKEN=

# Secret used to sign paging cursors. Any long random string, 32+ characters.
CURSOR_KEY=

# Optional: pretend "today" is this date (YYYY-MM-DD) so old sandbox data
# still looks current in the BP worklist.
DEMO_AS_OF=
